# =============================================================================
# Alchemy Hyperliquid — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env.
# Both apps read from the repo-root .env via dotenv when running locally.

# ---- API (apps/api) ---------------------------------------------------------

# Alchemy's builder wallet address (the one users approve a fee to). 0x-prefixed.
# This wallet must be funded with >= 100 USDC in perps on Hyperliquid mainnet
# and run in standard (non-account-abstraction) mode.
ALCHEMY_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000

# Hyperliquid REST base URL.
#   mainnet:  https://api.hyperliquid.xyz
#   testnet:  https://api.hyperliquid-testnet.xyz
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz

# Builder fees in basis points (1 bps = 0.01%).
# Defaults: perps = 4 (0.04%), spot = 5 (0.05%).
PERPS_BUILDER_FEE_BPS=4
SPOT_BUILDER_FEE_BPS=5

# Hyperliquid protocol-enforced maximums. Do not raise above these.
MAX_BUILDER_FEE_BPS_PERPS=10
MAX_BUILDER_FEE_BPS_SPOT=100

# API server port.
PORT=8080

# Allowed CORS origin for the web app. Comma-separated for multiple.
WEB_ORIGIN=http://localhost:3000

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Layer 2 — server-side master seed for per-user agent wallet derivation.
# Used by HL approveAgent + unattended AI trading. Optional; if unset,
# approveAgent build + /agent endpoint return INVALID_PARAMS.
#
# Generate once per deployment:
#   openssl rand -hex 32
#
# Keep this secret. Anyone with the seed can derive every user's agent key
# (trade-only authority — can't withdraw — but still abusable).
AGENT_MASTER_SEED=

# Path B — HS256 secret for OAuth access tokens the MCP server issues to
# Claude Web / ChatGPT Apps. Same value on api + mcp + web. 32 bytes hex.
#   openssl rand -hex 32
OAUTH_SIGNING_SECRET=

# Public URLs for OAuth flow. Defaults work for local dev.
# In production, set to the real hosted URLs.
MCP_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000

# Bearer token guarding GET /metrics on the api (Prometheus exposition —
# includes estimated builder-fee revenue). Optional: unset leaves /metrics
# open, fine for local dev. Set in production:
#   openssl rand -hex 16
METRICS_TOKEN=

# ---- Jurisdiction gating (api) ----------------------------------------------
# The relay forwards signed orders, so US/sanctioned-jurisdiction exclusion for
# live trading is enforced here, not just in the UI. Agent.trade public market
# data and paper endpoints remain accessible so restricted users can use
# paper-only mode. Country comes from the edge — Cloudflare's cf-ipcountry
# header — so the relay must sit behind Cloudflare for this to bite.
#
# Master switch. "true" (default) rejects restricted regions on guarded live
# mutation surfaces with HTTP 451.
# Set "false" only for local dev or a deployment cleared with counsel.
GEO_BLOCK_ENABLED=true
# Comma-separated ISO 3166-1 alpha-2 codes. Defaults to US + OFAC-embargoed set,
# mirroring the venues we route into. Country-granular only (no CA-ON/Ontario —
# enforce subdivisions at the CF WAF if needed).
RESTRICTED_COUNTRIES=US,CU,IR,KP,SY,RU
# Header carrying the resolved country. Default cf-ipcountry; override for other
# edges (x-vercel-ip-country, fly-client-country, ...).
GEO_COUNTRY_HEADER=cf-ipcountry
# When "true", block requests whose country can't be determined (header missing
# or "XX" — e.g. hitting the Render origin directly, past Cloudflare). Recommend
# "true" in prod; "false" by default so local dev isn't blackholed.
GEO_FAIL_CLOSED=false

# ---- Agent.trade MVP live-order safety --------------------------------------
# Read-only market data may point at mainnet, but live order execution should
# use Hyperliquid testnet by default. If HYPERLIQUID_API_URL is mainnet,
# Agent.trade order actions are blocked unless the explicit flag, eligibility,
# acknowledgement, and kill-switch checks pass.
AGENT_TRADE_MAINNET_EXECUTION_ENABLED=false
# Global live-trading kill switch. When true, /exchange rejects live orders and
# the web terminal falls back to paper mode.
AGENT_TRADE_LIVE_TRADING_KILL_SWITCH=false
# Hyperliquid minimum trade notional enforced before forwarding live orders.
AGENT_TRADE_MIN_ORDER_NOTIONAL_USD=10
# Optional product safety throttles enforced server-side before forwarding
# orders. Set either to 0 to disable the Agent.trade throttle and defer max-size
# rejection to Hyperliquid.
AGENT_TRADE_ORDER_NOTIONAL_CAP_USD=250
AGENT_TRADE_DAILY_NOTIONAL_CAP_USD=1000
# Reserved for internal compatibility flows; mainnet Agent.trade order
# execution is governed by the policy flags above, not by this allowlist.
AGENT_TRADE_INTERNAL_ALLOWLIST=
# /exchange requires these acknowledgements as request headers after the user
# confirms the modal: x-agent-trade-risk-accepted:true and
# x-agent-trade-terms-accepted:true.
AGENT_TRADE_REQUIRE_RISK_ACK=true
# Agent.trade fail-closed eligibility. When true, missing/unknown country
# produces "unknown" eligibility even if generic GEO_BLOCK_ENABLED=false.
AGENT_TRADE_REQUIRE_GEO_ELIGIBILITY=true
# Gasless Hyperliquid deposit relayer. Keep disabled until the relayer wallet is
# funded with Arbitrum ETH and AGENT_TRADE_GASLESS_DEPOSIT_ALLOWED_WALLETS lists
# the exact tester wallets. The private key is server-only.
AGENT_TRADE_ENABLE_GASLESS_HL_DEPOSIT=false
AGENT_TRADE_GASLESS_DEPOSIT_ALLOWED_WALLETS=
AGENT_TRADE_DEPOSIT_RELAYER_PRIVATE_KEY=
AGENT_TRADE_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
AGENT_TRADE_HL_BRIDGE_ARBITRUM=0x2Df1c51E09aECF9cacB7bc98cB1742757f163dF7
AGENT_TRADE_USDC_ARBITRUM=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# ---- Web (apps/web) ---------------------------------------------------------

# Optional legal hard-block for web routes. Default false keeps Agent.trade UI
# accessible for restricted or unknown users in paper-only mode. Set true only
# if legal/compliance requires hiding the app entirely in restricted regions.
AGENT_TRADE_HARD_BLOCK_RESTRICTED_UI=false

# Where the web app should send API requests.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public-readable copy of the builder address (shown in the UI).
NEXT_PUBLIC_BUILDER_ADDR=0x0000000000000000000000000000000000000000

# Privy app ID (client). Get one at https://dashboard.privy.io.
# When configured in the Privy dashboard, the current app can show email,
# Google, and existing-wallet login. For users without a wallet, Privy can
# create an embedded Arbitrum wallet. SMS, Apple, and passkey login are not
# wired in this repo today.
NEXT_PUBLIC_PRIVY_APP_ID=

# Agent.trade funding/on-ramp UI gate. Default false. The funding CTA only
# opens when this flag is true, Privy is configured, a wallet is connected,
# live eligibility is confirmed, and Privy's funding hook is available.
# Keep false unless Privy funding providers are configured and
# legal/compliance has approved the environment. Card, bank, ACH, Apple Pay,
# Google Pay, Coinbase, Meld, Stripe, and generic deposit-address flows are not
# wired by this flag alone.
NEXT_PUBLIC_AGENT_TRADE_ENABLE_PRIVY_FUNDING=false

# Agent.trade legacy compatibility gates. Default false. These are not normal
# internal-MVP onboarding/funding methods; they expose legacy approval and
# Hyperliquid Bridge2 deposit compatibility screens only after explicit
# enablement, live eligibility, and legal/compliance review.
NEXT_PUBLIC_AGENT_TRADE_ENABLE_LEGACY_APPROVALS=false
NEXT_PUBLIC_AGENT_TRADE_ENABLE_OAUTH_COMPAT_APPROVALS=false
NEXT_PUBLIC_AGENT_TRADE_ENABLE_HL_BRIDGE_DEPOSIT=false
NEXT_PUBLIC_AGENT_TRADE_ENABLE_GASLESS_HL_DEPOSIT=false

# Future auth-method placeholders. These are comments only; the app does not
# read or wire these flags yet.
# NEXT_PUBLIC_AGENT_TRADE_ENABLE_SMS_LOGIN=false
# NEXT_PUBLIC_AGENT_TRADE_ENABLE_APPLE_LOGIN=false
# NEXT_PUBLIC_AGENT_TRADE_ENABLE_PASSKEY_LOGIN=false

# Privy app ID + secret (server-side). Both required for the API to verify
# Privy JWTs on /agent/exchange and /oauth/issue-code. PRIVY_APP_ID is the
# same public string as NEXT_PUBLIC_PRIVY_APP_ID above. PRIVY_APP_SECRET is
# secret — get it from your Privy dashboard. Without both, the Privy-JWT
# auth path is disabled (only OAuth access tokens work).
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Internal-only feature flag: when "true", /approve renders a "Place test
# trade" card in the approved state. Used for smoke-testing the fee-earning
# loop on mainnet from inside our app. NOT product surface — the product is
# the API for agents; this is dev scaffolding. Always leave false in
# production deploys.
NEXT_PUBLIC_ENABLE_TEST_TRADE=false
